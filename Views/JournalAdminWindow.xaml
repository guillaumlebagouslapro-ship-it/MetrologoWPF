<ui:FluentWindow x:Class="Metrologo.Views.JournalAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Journal administrateur"
        Height="720" Width="1000"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Icon="/Resources/logo.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Journal administrateur">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Resources/logo.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Grid.Row="1" Padding="24,14,24,8">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="10"
                        Background="{StaticResource AsertiNavyBrush}" Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Journal administrateur"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AsertiNavyBrush}"/>
                    <TextBlock Text="Qui s'est connecté à l'administration, et ce qu'il a modifié."
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="24,0,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Rechercher un administrateur, une action, un poste…" Padding="10,6">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24"/>
                </ui:TextBox.Icon>
            </ui:TextBox>
            <CheckBox Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                      Content="Mises à jour automatiques (Besançon)"
                      IsChecked="{Binding AfficherAutomatiques}"/>
        </Grid>

        <!-- Une carte par connexion : en-tête (qui / quand / poste) puis ses actions -->
        <ScrollViewer Grid.Row="3" Margin="24,0,24,8" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Blocs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Carte" CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                                Background="White" BorderThickness="1,1,1,1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Titre" Grid.Column="0" Text="{Binding Titre}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource AsertiNavyBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SousTitre}" Margin="12,0,0,0"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Border x:Name="Pastille" Grid.Column="2" CornerRadius="10" Padding="10,2"
                                            Background="#FFE0E7FF" VerticalAlignment="Center">
                                        <TextBlock x:Name="TexteResume" Text="{Binding Resume}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="#FF4338CA"/>
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Actions}" Margin="0,6,0,0"
                                              Visibility="{Binding AActions, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding HeureAffichee}" FontSize="12"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LibelleAffiche}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="{StaticResource AsertiNavyBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Margin="10,0,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <!-- Connexion sans action : pastille grise, discrète -->
                            <DataTrigger Binding="{Binding AActions}" Value="False">
                                <Setter TargetName="Pastille" Property="Background" Value="#FFF1F5F9"/>
                                <Setter TargetName="TexteResume" Property="Foreground" Value="#FF64748B"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Refus">
                                <Setter TargetName="Titre" Property="Foreground" Value="#FFC62828"/>
                                <Setter TargetName="Carte" Property="Background" Value="#FFFDF2F2"/>
                                <Setter TargetName="Pastille" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Automatique">
                                <Setter TargetName="Titre" Property="Foreground" Value="#FF64748B"/>
                                <Setter TargetName="Carte" Property="Background" Value="#FFF8FAFC"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="4" Padding="24,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Statut}"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📄 Ouvrir le fichier"
                            Command="{Binding OuvrirFichierCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8" Margin="0,0,8,0"/>
                    <Button Content="Rafraîchir"
                            Command="{Binding RafraichirCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8" MinWidth="100" Margin="0,0,8,0"/>
                    <Button Content="Fermer" IsCancel="True" IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,8" MinWidth="100"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
