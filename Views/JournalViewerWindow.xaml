<ui:FluentWindow x:Class="Metrologo.Views.JournalViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Journal &amp; maintenance"
        Height="760" Width="1120"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Icon="/Resources/logo.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Journal &amp; maintenance">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Resources/logo.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- En-tête -->
        <Border Grid.Row="1" Padding="24,14,24,4">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="10"
                        Background="{StaticResource AsertiNavyBrush}" Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="History24" FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Journal &amp; maintenance"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AsertiNavyBrush}"/>
                    <TextBlock Text="Fiches d'intervention, journal système (connexions, mesures, erreurs) et maintenance des logs."
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Margin="24,0,24,8"
                    Background="Transparent" BorderThickness="0"
                    SelectedIndex="{Binding OngletIndex}">

            <!-- ============ Onglet 1 : fiches d'intervention ============ -->
            <TabItem Header="Fiches d'intervention">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Recherche -->
                    <Border Grid.Row="0" Padding="0,12,0,8">
                        <ui:TextBox Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Rechercher une FI ou un opérateur…" Padding="10,6">
                            <ui:TextBox.Icon>
                                <ui:SymbolIcon Symbol="Search24"/>
                            </ui:TextBox.Icon>
                        </ui:TextBox>
                    </Border>

                    <!-- Liste des fiches -->
                    <Border Grid.Row="1" Margin="0,0,0,8" Background="White"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- En-têtes de colonnes. Marges alignées sur le contenu des lignes (10 padding
                                 + 1 bordure = 11 à gauche) et réservation de la scrollbar à droite (≈17 +
                                 11) pour que les colonnes de droite restent alignées avec les valeurs. -->
                            <Grid Grid.Row="0" Margin="11,2,28,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="FICHE (FI)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AsertiOrangeBrush}"/>
                                <TextBlock Grid.Column="1" Text="OPÉRATEUR(S)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AsertiOrangeBrush}"/>
                                <TextBlock Grid.Column="2" Text="DERNIÈRE ACTIVITÉ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AsertiOrangeBrush}"/>
                                <TextBlock Grid.Column="3" Text="MESURES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AsertiOrangeBrush}"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible">
                                <ItemsControl ItemsSource="{Binding Fiches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,4"
                                                    Background="White"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding NumFI}"
                                                                   FontWeight="Bold" FontSize="13"
                                                                   Foreground="{StaticResource AsertiNavyBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="en local (pas encore sur le réseau)"
                                                                   FontSize="10" Foreground="{StaticResource AsertiOrangeDarkBrush}"
                                                                   Visibility="{Binding EstLocale, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding OperateursAffiches}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource AsertiNavyBrush}"/>

                                                    <TextBlock Grid.Column="2" Text="{Binding DerniereActiviteAffichee}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                                    <Border Grid.Column="3" Background="#FFE0E7FF" CornerRadius="10"
                                                            Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding NbMesures}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="#FF4338CA"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="📄 Journal"
                                                                Command="{Binding DataContext.OuvrirFichierCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Padding="12,6" Margin="0,0,6,0"
                                                                IsEnabled="{Binding LogPresent}"/>
                                                        <Button Content="📁 Dossier"
                                                                Command="{Binding DataContext.OuvrirDossierCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Padding="12,6"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Statut}" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Content="Rafraîchir" Command="{Binding RafraichirCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" MinWidth="100"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ Onglet 2 : journal système ============ -->
            <TabItem Header="Journal système">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filtres -->
                    <Grid Grid.Row="0" Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Periodes}"
                                  SelectedItem="{Binding PeriodeSysteme}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                                  Content="Erreurs et avertissements seulement"
                                  IsChecked="{Binding AnomaliesSeulement}"/>
                        <ui:TextBox Grid.Column="2" Text="{Binding RechercheSysteme, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Rechercher (action, message, utilisateur, poste…)" Padding="10,6">
                            <ui:TextBox.Icon>
                                <ui:SymbolIcon Symbol="Search24"/>
                            </ui:TextBox.Icon>
                        </ui:TextBox>
                    </Grid>

                    <!-- Entrées (DataGrid virtualisée : plusieurs milliers de lignes possibles) -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding EntreesSysteme}"
                              SelectedItem="{Binding EntreeSelectionnee}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              RowBackground="White" AlternatingRowBackground="#FFF8FAFC"
                              FontSize="12" BorderThickness="1"
                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <DataGrid.Resources>
                            <!-- Avertissements en orange, erreurs en rouge (posé sur le TextBlock de la
                                 cellule : le fond des lignes est déjà géré par AlternatingRowBackground). -->
                            <Style x:Key="TexteSelonGravite" TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severite}" Value="Avertissement">
                                        <Setter Property="Foreground" Value="#FFB45309"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severite}" Value="Erreur">
                                        <Setter Property="Foreground" Value="#FFC62828"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date / heure" Binding="{Binding HorodatageAffiche}" Width="140"/>
                            <DataGridTextColumn Header="Gravité" Binding="{Binding SeveriteLibelle}" Width="65"
                                                ElementStyle="{StaticResource TexteSelonGravite}"/>
                            <DataGridTextColumn Header="Utilisateur" Binding="{Binding UtilisateurAffiche}" Width="100"/>
                            <DataGridTextColumn Header="Poste" Binding="{Binding Machine}" Width="100"/>
                            <DataGridTextColumn Header="Catégorie" Binding="{Binding CategorieLibelle}" Width="105"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="170"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"
                                                ElementStyle="{StaticResource TexteSelonGravite}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Détail de l'entrée sélectionnée -->
                    <TextBox Grid.Row="2" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap"
                             MaxHeight="90" VerticalScrollBarVisibility="Auto" FontSize="11"
                             FontFamily="Cascadia Mono, Consolas"
                             Text="{Binding EntreeSelectionnee.DetailsLisibles, Mode=OneWay, FallbackValue='', TargetNullValue='(pas de détail)'}"/>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatutSysteme}" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="📄 Fichier texte du mois" Command="{Binding OuvrirTexteDuMoisCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0"/>
                            <Button Content="Rafraîchir" Command="{Binding RafraichirSystemeCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" MinWidth="100"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ Onglet 3 : maintenance ============ -->
            <TabItem Header="Maintenance">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- État des emplacements -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                            BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Dossier Logs" FontWeight="SemiBold" Foreground="{StaticResource AsertiNavyBrush}" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EtatDossierLogs}" FontSize="12" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1" Text="Dossier Mesures (FI)" FontWeight="SemiBold" Foreground="{StaticResource AsertiNavyBrush}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EtatDossierMesures}" FontSize="12" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="2" Text="Audit administrateur" FontWeight="SemiBold" Foreground="{StaticResource AsertiNavyBrush}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EtatAuditAdmin}" FontSize="12" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Text="MOIS DE LOGS SYSTÈME" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource AsertiOrangeBrush}" Margin="2,0,0,6"/>

                    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="10"
                            BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding MoisLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="10,6" Margin="0,0,0,4" Background="White"
                                                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Libelle}" FontWeight="Bold"
                                                           VerticalAlignment="Center" Foreground="{StaticResource AsertiNavyBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding EtatAffiche}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TailleAffichee}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Dossier}" FontSize="11" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="📄 Ouvrir"
                                                            Command="{Binding DataContext.OuvrirMoisLogsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,6,0"/>
                                                    <Button Content="🗄 Archiver"
                                                            Command="{Binding DataContext.ArchiverMoisCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButtonStyle}" Padding="12,4"
                                                            Visibility="{Binding PeutArchiver, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatutMaintenance}" VerticalAlignment="Center" FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="📁 Dossier Logs" Command="{Binding OuvrirDossierLogsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0"/>
                            <Button Content="Rafraîchir" Command="{Binding RafraichirMaintenanceCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" MinWidth="100"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="3" Padding="24,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Button Content="Fermer" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="14,8" MinWidth="100"/>
        </Border>
    </Grid>
</ui:FluentWindow>
